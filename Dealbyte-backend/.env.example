# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/dealbyte?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── SMTP (Nodemailer) ──────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@dealbyte.com"

# ─── Azure Blob Storage ─────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="proposals"

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"
